name: Tests
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  tests:
    env:
      PYTHONUTF8: '1'
    strategy:
      matrix:
        os: [windows-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: python -m unittest discover -s tests -v
      - run: node tests/parser.test.cjs
      - run: node tests/adapters.test.cjs
      - run: node tests/theme.test.cjs
      - run: node --check web/app.js
      - run: node --check extension/panel.js
      - run: node --check extension/adapters.js
